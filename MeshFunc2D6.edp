plot(MacroTh, wait=true, fill=false, cmm="2");*/

func mesh MDiamond(int m, int n, 
                   int nGrid0, 
                   real a, real b, 
                   int isHole)
{
	mesh BasicTh = CDiamond(a, b, nGrid0, isHole);
    return extendXY(BasicTh, m, n, 1, 1);
}
//mesh MacroTh3 = MDiamond(n, n, 30, 0.3, 0.3, 0);
//plot(MacroTh3, wait=true, fill=false, cmm="3");
func mesh MRectangleHoleCompo(int m, int n, 
                              int nGrid0,
                              real M1x, real M1y,
                              real M1Width, real M1Height,
                              real M2x, real M2y,
                              real M2Width, real M2Height
                              )
{
	mesh BasicTh = CRectangleHoleCompo(M1x, M1y, M1Width, M1Height,
	                                   M2x, M2y, M2Width, M2Height,
	                                   nGrid0);
    return extendXY(BasicTh, m, n, 1, 1);              
}

func mesh MLayeredY(int nx, int ny, real ratio, int nGrid)
{   mesh BasicTh = CLayeredY(ratio, nGrid);
    mesh MacroTh = extendXY(BasicTh, nx, ny, 1.0, 1.0);   
    return MacroTh;
}

